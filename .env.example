# ==============================================================================
# KURO SHELF - ENVIRONMENT VARIABLES FOR VERCEL & LOCAL DEVELOPMENT
# ==============================================================================
# Instructions for Vercel:
# 1. In your Vercel Project Dashboard, navigate to: Settings -> Environment Variables
# 2. Add the required variables below.
# Note: Variables prefixed with VITE_ are bundled safely into the client code.
# ==============================================================================

# --- SUPABASE CONFIGURATION (Recommended for Accounts & Cloud Sync) ---
# Found in your Supabase project under: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# --- CONTACT & SUPPORT ---
# Email address displayed in the Contact, Privacy, and DMCA policy modals
VITE_CONTACT_EMAIL=contact@kuroshelf.com

# --- OPTIONAL: JIKAN API OVERRIDE ---
# Defaults automatically to https://api.jikan.moe/v4 if omitted
# JIKAN_API_BASE_URL=https://api.jikan.moe/v4

# --- OPTIONAL: AFFILIATE SETTINGS ---
# VITE_AMAZON_AFFILIATE_ACTIVE=true
# VITE_AMAZON_AFFILIATE_TAG=kuroshelf-20

# --- OPTIONAL: COMMUNITY DISCUSSIONS (Disqus) ---
# VITE_DISQUS_SHORTNAME=kuroshelf
# VITE_DISQUS_URL=https://disqus.com/by/kuroshelf/

# --- OPTIONAL: OFFICIAL SOCIAL MEDIA HANDLES ---
# VITE_SOCIAL_DISCORD=https://discord.gg/your-invite
# VITE_SOCIAL_TWITTER=https://x.com/kuroshelf
# VITE_SOCIAL_INSTAGRAM=https://instagram.com/kuroshelf
# VITE_SOCIAL_YOUTUBE=https://youtube.com/@kuroshelf

# --- OPTIONAL: PAYMENT GATEWAY (For donations / VIP memberships) ---
# VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
